# 入口は index.php のログイン画面。ブラウザの認証ダイアログは出さない。
DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(auth\.php|index\.html|install\.html)$">
  Require all denied
</FilesMatch>

# ホーム画面への追加は、Chrome がログインのクッキーなしで取りに来る。
# マニフェスト、192/512 アイコン、サービスワーカーだけ公開する。
<FilesMatch "^(manifest\.json|sw\.js|icon-192\.png|icon-512\.png|icon-maskable-512\.png)$">
  Require all granted
</FilesMatch>

RewriteEngine On
RewriteRule ^(index\.html|install\.html|app\.js|styles\.css)$ gate.php [L]
RewriteRule ^download/kubiraku\.apk$ gate.php [L]

<IfModule mod_mime.c>
  AddType application/manifest+json .json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "accelerometer=(self), gyroscope=(self), magnetometer=(self)"
  <Files "manifest.json">
    Header set Content-Type "application/manifest+json; charset=UTF-8"
  </Files>
  <Files "sw.js">
    Header set Content-Type "application/javascript; charset=UTF-8"
  </Files>
</IfModule>
